# Messenger Backend Environment Configuration Template

# Database Connection
ConnectionStrings__DefaultConnection="Server=localhost\\SQLEXPRESS;Database=MessengerDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;"

# JWT Security
JwtSettings__Secret="MessengerSuperSecretKeyForJwtAuthenticationTokenSigning2026!"
JwtSettings__Issuer="MessengerApi"
JwtSettings__Audience="MessengerClients"
JwtSettings__AccessTokenExpirationMinutes=60
JwtSettings__RefreshTokenExpirationDays=30

# File Storage
StorageSettings__Provider="Local"
StorageSettings__LocalStoragePath="./uploads"
StorageSettings__MaxFileSizeBytes=52428800 # 50 MB
